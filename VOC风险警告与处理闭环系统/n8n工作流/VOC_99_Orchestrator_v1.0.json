    {
      "parameters": {
        "jsCode": "const voc03 = $input.first().json;\n\n// V03 当前无论最终返回 NOOP 报告还是写入报告，\n// 都优先读取整轮规划统计\nconst summary =\n  voc03.summary_all_actions ??\n  voc03.action_summary ??\n  {};\n\nconst CREATE = Number(summary.CREATE ?? 0);\nconst UPDATE = Number(summary.UPDATE ?? 0);\nconst INVALIDATE = Number(summary.INVALIDATE ?? 0);\nconst NOOP = Number(summary.NOOP ?? 0);\nconst ERROR = Number(summary.ERROR ?? 0);\n\nconst plannedWriteCount = CREATE + UPDATE + INVALIDATE;\n\n// V03 只有在实际写飞书成功、且没有规划错误时才会正常返回到 V99。\n// 因此 V99 能走到这里时，可把本轮计划写入数视为成功写入数。\nconst writeSuccess = ERROR === 0 ? plannedWriteCount : 0;\nconst writeFailed = ERROR;\n\nreturn [\n  {\n    json: {\n      pipeline: 'VOC_PIPELINE_V1',\n      status: ERROR === 0 ? 'SUCCESS' : 'FAILED',\n\n      stages: {\n        VOC_00_CSVLoader: 'SUCCESS',\n        VOC_01_SourceAdapter: 'SUCCESS',\n        VOC_02_AnalysisPipeline: 'SUCCESS',\n        VOC_03_FeishuRiskSync: ERROR === 0 ? 'SUCCESS' : 'FAILED',\n      },\n\n      voc03_result: {\n        action_summary: {\n          CREATE,\n          UPDATE,\n          INVALIDATE,\n          NOOP,\n          ERROR,\n        },\n\n        planned_write_count: plannedWriteCount,\n        write_success: writeSuccess,\n        write_failed: writeFailed,\n      },\n\n      completed_at: new Date().toISOString(),\n    },\n  },\n];"
      },
